# Suraa backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Variable names only here; every one of these is read exclusively via src/config/env.ts.
#
# `cp .env.example .env` then set JWT_SECRET, and the app boots on the mocks — no API keys
# needed. The OPTIONAL keys below stay COMMENTED OUT until you actually turn their adapter on:
# an empty value is not the same as an absent one. `GASTAT_CPI_URL=` is a present-but-empty
# string, and it fails url validation at boot; leaving the line commented is what makes it
# genuinely optional.

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Database (required) ---------------------------------------------------
# Matches docker-compose.yml if you run `npm run db:up`.
DATABASE_URL=postgresql://suraa:suraa@localhost:5432/suraa?schema=public

# ---- Auth (required) -------------------------------------------------------
# THE ONE VALUE YOU MUST FILL IN. At least 32 characters, or the app refuses to boot.
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Adapter selection -----------------------------------------------------
# Flip these to swap a mock for the real thing. Nothing else changes.
# mock  → calibrated ~2.0% CPI  |  gastat → real ingest (needs GASTAT_CPI_URL)
ECONOMIC_PROVIDER=mock
# mock  → illustrative sample offers  |  bank_api → real lenders (not implemented yet)
OFFERS_PROVIDER=mock
# mock  → realistic sample SIMAH report  |  real → throws until SAMA-licensed + SIMAH member.
# Picks the adapter only; whether SIMAH is consulted is the `simah_credit` feature flag (off).
SIMAH_PROVIDER=mock
# anthropic → real chatbot (needs ANTHROPIC_API_KEY)  |  mock → scripted, offline
# Defaults to `mock` so a fresh clone runs with no API key. Flip to `anthropic` and set the
# key below once you want the real chatbot.
LLM_PROVIDER=mock
# console → prints the OTP to the terminal (dev only)  |  smtp → real email
MAIL_TRANSPORT=console

# ---- Anthropic (required when LLM_PROVIDER=anthropic) ----------------------
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# ---- GASTAT (required when ECONOMIC_PROVIDER=gastat) -----------------------
# GASTAT_CPI_URL=https://...

# ---- Email (required when MAIL_TRANSPORT=smtp) -----------------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=Suraa <no-reply@suraa.sa>

# ---- Localization ----------------------------------------------------------
# Language of the plain-language messages the engine emits: ar | en
MESSAGE_LOCALE=ar

# ---- Logging ---------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
